#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# meshgw — control the Mesh Gateway service.
#
# The gateway (mesh_gateway.py) owns both radios and writes every inbound
# MeshCore/Meshtastic message to /tmp/meshgw_events.jsonl. It has NO direct
# chat SDK: an external delivery agent (see mesh_watch.py) delivers.
#
# Usage:
#   meshgw start   start the gateway service (owns both radios)
#   meshgw stop    stop it (frees radios for the GUI)
#   meshgw status  show service + last events
#   meshgw tail    live-tail inbound mesh messages
#   meshgw send mc "text"     send a message over MeshCore
#   meshgw send mt "text"     send a message over Meshtastic
#   meshgw events count       count events by network
set -euo pipefail

SVC=mesh-gateway.service
EVENTS=/tmp/meshgw_events.jsonl
PY=/opt/mesh-bridge/mesh-relay/.venv/bin/python

cmd="${1:-status}"
case "$cmd" in
  start)
    sudo systemctl enable --now "$SVC" >/dev/null 2>&1 || sudo systemctl start "$SVC"
    echo "mesh gateway started (owns both radios)"
    ;;
  stop)
    sudo systemctl stop "$SVC" || true
    echo "mesh gateway stopped (radios freed)"
    ;;
  status)
    echo "service: $(systemctl is-active "$SVC" 2>/dev/null)"
    echo "--- last 5 events ---"
    tail -n 5 "$EVENTS" 2>/dev/null | while read -r line; do
      echo "  $line" | python3 -c "import sys,json; e=json.loads(sys.stdin.read().strip()); print(f\"[{e.get('net','?')}] {e.get('sender','?')}: {e.get('text','?')}\")" 2>/dev/null || true
    done
    ;;
  tail)
    echo "watching $EVENTS (Ctrl+C to stop)..."
    tail -F "$EVENTS" 2>/dev/null | while read -r line; do
      echo "$line" | python3 -c "import sys,json; e=json.loads(sys.stdin.read()); print(f\"[{e.get('net','?')}] {e.get('sender','?')}: {e.get('text','?')}\")" 2>/dev/null || echo "$line"
    done
    ;;
  send)
    net="${2:-}"; shift 2 || true
    text="$*"
    if [[ -z "$net" || -z "$text" ]]; then
      echo "usage: meshgw send {mc|mt} \"text\"" >&2; exit 1
    fi
    "$PY" - "$net" "$text" <<'EOF'
import asyncio, sys
sys.path.insert(0, "/opt/mesh-bridge/mesh-relay")
from mesh_gateway import RadioBridge

async def main():
    b = RadioBridge()
    await b.connect()
    net, text = sys.argv[1], " ".join(sys.argv[2:])
    if net == "mc":
        await b.send_mc(text)
        print(f"sent over MeshCore: {text}")
    else:
        await b.send_mt(text)
        print(f"sent over Meshtastic: {text}")
    sys.exit(0)

asyncio.run(main())
EOF
    ;;
  reply)
    net="${2:-}"; shift 2 || true
    text="$*"
    if [[ -z "$net" || -z "$text" ]]; then
      echo "usage: meshgw reply {mc|mt|both} \"text\"" >&2; exit 1
    fi
    # write directly to the gateway-owned send queue (it holds the radios)
    case "$net" in
      mc|mt|both) printf '{"net":"%s","text":"%s"}\n' "$net" "$text" | tee /tmp/meshgw_send.txt >/dev/null ;;
      *) echo "net must be mc|mt|both" >&2; exit 1 ;;
    esac
    echo "queued reply over $net (gateway transmits): $text"
    ;;
  events)
    echo "count: $(wc -l < "$EVENTS" 2>/dev/null || echo 0)"
    echo "--- by network ---"
    python3 -c "
import json,sys,collections
c=collections.Counter()
try:
    for l in open('$EVENTS'):
        try:
            c[json.loads(l).get('net','?')]+=1
        except: c['bad']+=1
except FileNotFoundError: pass
for k,v in c.items(): print(f'  {k}: {v}')
"
    ;;
  *)
    echo "usage: meshgw {start|stop|status|tail|send mc|mt \"text\"|events}" >&2
    exit 1
    ;;
esac
